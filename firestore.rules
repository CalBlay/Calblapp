rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * PLACEHOLDER per poder usar la Firebase CLI (p. ex. deploy d'índexs).
     * Abans de fer MAI: firebase deploy --only firestore:rules
     * copieu aquí les regles reals des de:
     * Firebase Console → Firestore Database → Regles
     *
     * Aquest fitxer denega tot accés des del SDK client; no afecta l'Admin SDK
     * de la vostra API Next.js. Tot i així, no desplegueu aquestes regles a
     * producció sense substituir-les per les regles correctes.
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
